# ---- Database (Neon / Supabase / self-hosted Postgres) ----
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ---- Auth.js ----
# openssl rand -hex 32
AUTH_SECRET="change-me-openssl-rand-hex-32"
AUTH_TRUST_HOST=true
# Signs agent approval checkpoints (HMAC). REQUIRED in production:
# unset → per-process fallback, tokens fail across serverless instances.
# openssl rand -hex 32
KINESIS_CHECKPOINT_SECRET="change-me-openssl-rand-hex-32"
# Shared secret for Vercel Cron → GET /api/admin/sweep (daily stale-order sweep).
# openssl rand -hex 32
CRON_SECRET="change-me-openssl-rand-hex-32"
# https://console.cloud.google.com/apis/credentials — OAuth Client (Web)
GOOGLE_CLIENT_ID="xxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="xxx"
# Emails allowed into /admin (comma-separated)
ADMIN_EMAILS="you@example.com"

# ---- VNPay (sandbox → production) ----
# Register: https://vnpay.vn → merchant portal. Sandbox keys: https://sandbox.vnpayment.vn/devreg/
VNPAY_TMN_CODE="SANDBOX"
VNPAY_HASH_SECRET="change-me"
VNPAY_PAY_URL="https://sandbox.vnpayment.vn/paymentv2/vpcpay.html"
# Must be public — set to your production domain after deploy
VNPAY_RETURN_URL="https://your-domain.vercel.app/api/payment/vnpay/return"

# ---- Email (Resend) — order confirmation ----
RESEND_API_KEY=""
ORDER_FROM_EMAIL="orders@your-domain.com"
